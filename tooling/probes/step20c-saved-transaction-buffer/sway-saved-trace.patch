+/* WHY: passive private evidence identifies actual saved nodes and lifetime. */
+static long long saved_ns(void) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
