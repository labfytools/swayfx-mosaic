+/* WHY: pre-transaction geometry must be measured from the actual source node.
+ * CONTRACT: this private trace reads the mapped target only during get_tree.
+ * INVARIANT: no scene state, buffer reference or transaction is changed. */
+struct target_trace_context {
+    struct sway_container *container;
+};
+
+static void trace_target_source(struct wlr_scene_buffer *buffer,
+        int sx, int sy, void *data) {
+    struct target_trace_context *ctx = data;
+    int gx = 0, gy = 0;
+    bool valid = wlr_scene_node_coords(&buffer->node, &gx, &gy);
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    fprintf(stderr, "TARGET_SOURCE ns=%lld con=%p con_id=%zu view=%p node=%p buffer=%p parent=%p global_valid=%d global=%d,%d local=%d,%d source_size=%d,%d dest=%d,%d src_box=%.3f,%.3f,%.3f,%.3f transform=%d enabled=%d\n",
+        (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec,
+        (void *)ctx->container, ctx->container->node.id,
+        (void *)ctx->container->view, (void *)&buffer->node,
+        (void *)buffer->buffer, (void *)buffer->node.parent, valid, gx, gy, sx, sy,
+        buffer->buffer ? buffer->buffer->width : 0,
+        buffer->buffer ? buffer->buffer->height : 0,
+        buffer->dst_width, buffer->dst_height,
+        buffer->src_box.x, buffer->src_box.y,
+        buffer->src_box.width, buffer->src_box.height,
+        buffer->transform, buffer->node.enabled);
+}
+
