+// WHY: disjoint extreme endpoints must be rejected before subtraction.
+// CONTRACT: int64 intermediates; zero on empty; output may alias either input.
+// INVARIANT: no overflow is delegated to the historical wlroots box helper.
+static bool probe_clip_box_intersection(struct wlr_box *dest,
+		const struct wlr_box *a, const struct wlr_box *b) {
+	int64_t x1 = a->x > b->x ? a->x : b->x;
+	int64_t y1 = a->y > b->y ? a->y : b->y;
+	int64_t ax2 = (int64_t)a->x + a->width, bx2 = (int64_t)b->x + b->width;
+	int64_t ay2 = (int64_t)a->y + a->height, by2 = (int64_t)b->y + b->height;
+	int64_t x2 = ax2 < bx2 ? ax2 : bx2, y2 = ay2 < by2 ? ay2 : by2;
+	if (a->width <= 0 || a->height <= 0 || b->width <= 0 || b->height <= 0 ||
+			x2 <= x1 || y2 <= y1 || x2 - x1 > INT_MAX || y2 - y1 > INT_MAX) {
+		*dest = (struct wlr_box){0};
+		return false;
+	}
+	*dest = (struct wlr_box){(int)x1, (int)y1, (int)(x2-x1), (int)(y2-y1)};
+	return true;
+}
