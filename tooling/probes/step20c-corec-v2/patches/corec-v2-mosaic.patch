+// Camera conversion is validated before any double-to-integer cast.
+static int probe_camera_scroll(double scroll) {
+	if (!isfinite(scroll) || scroll < 0) return 0;
+	return scroll > INT_MAX ? INT_MAX : (int)scroll;
+}
