+// Experimental: derive a root popup clip from its actual tiled owner and the
+// already-applied Mosaic tiling clip. This avoids pending XDG geometry as a
+// source for the visible viewport; no owner pointer is stored on the clip.
+static void probe_clip_popup(struct wlr_scene_node *node,
+		struct sway_popup_desc *popup) {
+	struct wlr_scene_tree *popup_tree = wlr_scene_tree_from_node(node);
+	struct sway_container *con = popup->view ? popup->view->container : NULL;
+	struct sway_workspace *ws = con ? con->current.workspace : NULL;
+	if (!ws || ws->current.layout != L_MOSAIC || !ws->mosaic) {
+		wlr_scene_tree_set_clip(popup_tree, NULL);
+		return;
+	}
+	struct sway_container *owner = con;
+	bool fullscreen = false;
+	for (struct sway_container *ancestor = con; ancestor;
+			ancestor = ancestor->current.parent) {
+		fullscreen |= ancestor->current.fullscreen_mode != 0;
+		owner = ancestor;
+	}
+	if (!ws->current.tiling || list_find(ws->current.tiling, owner) < 0 || fullscreen) {
+		wlr_scene_tree_set_clip(popup_tree, NULL);
+		return;
+	}
+	struct wlr_box local_viewport;
+	struct sway_output *output = ws->current.output;
+	int tile_x, tile_y, popup_x, popup_y;
+	if (!output || output->current.active_workspace != ws ||
+			!wlr_scene_tree_get_clip(ws->layers.tiling, &local_viewport) ||
+			!wlr_scene_node_coords(&ws->layers.tiling->node, &tile_x, &tile_y) ||
+			!wlr_scene_node_coords(node, &popup_x, &popup_y)) {
+		struct wlr_box empty = {0};
+		wlr_scene_tree_set_clip(popup_tree, &empty);
+		return;
+	}
+	struct wlr_box global = local_viewport;
+	int64_t gx = (int64_t)tile_x + global.x;
+	int64_t gy = (int64_t)tile_y + global.y;
+	if (gx < INT_MIN || gx > INT_MAX || gy < INT_MIN || gy > INT_MAX) {
+		struct wlr_box empty = {0};
+		wlr_scene_tree_set_clip(popup_tree, &empty);
+		return;
+	}
+	global.x = (int)gx;
+	global.y = (int)gy;
+	struct wlr_box output_box = {
+		.x = output->lx, .y = output->ly,
+		.width = output->width, .height = output->height,
+	};
+	if (!probe_clip_box_intersection(&global, &global, &output_box)) {
+		struct wlr_box empty = {0};
+		wlr_scene_tree_set_clip(popup_tree, &empty);
+		return;
+	}
+	// EXPERIMENTAL INVARIANT: the viewport alone does not imply that its
+	// popup owner is visible. Use the already-applied scene position and size,
+	// not pending layout geometry, to suppress a fully hidden owner's popup.
+	int owner_x = INT_MIN, owner_y = INT_MIN;
+	struct wlr_box owner_visible;
+	if (!wlr_scene_node_coords(&con->scene_tree->node, &owner_x, &owner_y) ||
+			con->animation_state.current_width <= 0 ||
+			con->animation_state.current_height <= 0 ||
+			!probe_clip_box_intersection(&owner_visible, &global,
+				&(struct wlr_box){
+					.x = owner_x, .y = owner_y,
+					.width = con->animation_state.current_width,
+					.height = con->animation_state.current_height,
+				})) {
+		struct wlr_box empty = {0};
+		wlr_scene_tree_set_clip(popup_tree, &empty);
+		// Sampled applied geometry only; logging timing neutrality NOT_PROVEN.
+		sway_log(SWAY_INFO, "PROBE_POPUP_HIDDEN_OWNER owner=%p applied=%d,%d %dx%d viewport=%d,%d %dx%d",
+			(void *)con, owner_x, owner_y,
+			con->animation_state.current_width,
+			con->animation_state.current_height,
+			global.x, global.y, global.width, global.height);
+		return;
+	}
+	int64_t px = (int64_t)global.x - popup_x;
+	int64_t py = (int64_t)global.y - popup_y;
+	if (px < INT_MIN || px > INT_MAX || py < INT_MIN || py > INT_MAX) {
+		struct wlr_box empty = {0};
+		wlr_scene_tree_set_clip(popup_tree, &empty);
+		return;
+	}
+	global.x = (int)px;
+	global.y = (int)py;
+	wlr_scene_tree_set_clip(popup_tree, &global);
+	// WHY/CONTRACT: preserve sampled applied clip evidence, no GPU identity.
+	// INVARIANT: this trace does not prove generation or timing neutrality.
+	sway_log(SWAY_INFO, "PROBE_POPUP_CLIP owner=%p local=%d,%d %dx%d",
+		(void *)con, global.x, global.y, global.width, global.height);
+}
