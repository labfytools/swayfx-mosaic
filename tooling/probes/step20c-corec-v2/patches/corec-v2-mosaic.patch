+		return;
+	}
+	struct mosaic_row *row = ws->mosaic->rows->items[0];
+	int64_t width = (int64_t)area->width - gaps->left - gaps->right;
+	int64_t height = (int64_t)area->height - gaps->top - gaps->bottom;
+	struct wlr_box clip = {0};
+	if (isfinite(row->state.scroll_x) && row->state.scroll_x >= 0 &&
+			row->state.scroll_x <= INT_MAX && width > 0 && width <= INT_MAX &&
