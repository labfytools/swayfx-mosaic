+void wlr_scene_tree_set_clip(struct wlr_scene_tree *tree, const struct wlr_box *clip) {
+	// WHY: mandatory clip changes must never allocate or silently fail open.
+	// CONTRACT: only factory-created trees may be passed, never embedded root.
+	// INVARIANT: NULL deactivates without releasing the reservation.
+	assert(tree && (!clip || (clip->width >= 0 && clip->height >= 0)));
