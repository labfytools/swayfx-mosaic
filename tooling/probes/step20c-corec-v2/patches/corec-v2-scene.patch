+	if (clip && entry->active && memcmp(&entry->box, clip, sizeof(*clip)) == 0) return;
+	// WHY: private samples need the clip applied by this setter, including NULL.
+	// CONTRACT: passive sampled logging only; timing neutrality NOT_PROVEN.
+	// INVARIANT: no transaction generation, commit/present or GPU identity inferred.
+	wlr_log(WLR_INFO, "SPIKE_CLIP tree=%p rect=%d,%d %dx%d",
+		(void *)tree, clip ? clip->x : 0, clip ? clip->y : 0,
+		clip ? clip->width : 0, clip ? clip->height : 0);
+	entry->active = clip != NULL;
+	if (clip) entry->box = *clip;
+	scene_node_update(&tree->node, NULL);
+}
