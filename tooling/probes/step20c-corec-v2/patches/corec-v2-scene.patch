+static void scene_tree_clip_remove(struct scene_tree_clip *clip) {
+	struct scene_tree_clip **link = &scene_tree_clips;
+	while (*link != clip) link = &(*link)->next;
+	*link = clip->next;
+	wl_list_remove(&clip->destroy.link);
+	free(clip);
