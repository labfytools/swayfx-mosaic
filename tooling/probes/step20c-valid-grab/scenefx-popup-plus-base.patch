+// Experimental sidecar preserves the public scene structs shared with wlroots.
+// A production primitive needs an upstream-owned, scalable attachment design.
+struct scene_tree_clip {
+	struct scene_tree_clip *next;
+	struct wlr_scene_tree *tree;
+	struct wlr_box box;
+	struct wl_listener destroy;
