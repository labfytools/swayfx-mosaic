+// WHY: leaf visibility is also the render/damage boundary for SceneFX effects.
+// CONTRACT: clips are tree-local and intersect across all ancestors.
+// INVARIANT: a descendant cannot expose pixels beyond any ancestor clip.
+static void scene_node_intersect_clip(struct wlr_scene_node *node,
+		pixman_region32_t *region) {
+	for (struct wlr_scene_node *ancestor = node; ancestor != NULL;
+			ancestor = ancestor->parent ? &ancestor->parent->node : NULL) {
+		if (ancestor->type != WLR_SCENE_NODE_TREE) {
+			continue;
+		}
+		struct scene_tree_clip *clip = scene_tree_clip_find(wlr_scene_tree_from_node(ancestor));
+		if (!clip) {
+			continue;
+		}
+		int x, y;
+		wlr_scene_node_coords(ancestor, &x, &y);
+		pixman_region32_intersect_rect(region, region,
+			x + clip->box.x, y + clip->box.y,
+			clip->box.width, clip->box.height);
+	}
+}
