+static struct scene_tree_clip *scene_tree_clip_find(struct wlr_scene_tree *tree) {
+	for (struct scene_tree_clip *it = scene_tree_clips; it; it = it->next) {
+		if (it->tree == tree) return it;
+	}
+	return NULL;
+}
+
+static void scene_tree_clip_remove(struct scene_tree_clip *clip) {
+	struct scene_tree_clip **link = &scene_tree_clips;
+	while (*link != clip) link = &(*link)->next;
+	*link = clip->next;
+	wl_list_remove(&clip->destroy.link);
+	free(clip);
+}
+
+static void scene_tree_clip_destroy(struct wl_listener *listener, void *data) {
+	struct scene_tree_clip *clip = wl_container_of(listener, clip, destroy);
+	scene_tree_clip_remove(clip);
+}
