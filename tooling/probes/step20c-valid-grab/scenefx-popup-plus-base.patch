+static bool scene_node_point_inside_clip(struct wlr_scene_node *node,
+		double lx, double ly) {
+	for (struct wlr_scene_node *ancestor = node; ancestor != NULL;
+			ancestor = ancestor->parent ? &ancestor->parent->node : NULL) {
+		if (ancestor->type != WLR_SCENE_NODE_TREE) {
+			continue;
+		}
+		struct scene_tree_clip *entry = scene_tree_clip_find(wlr_scene_tree_from_node(ancestor));
+		if (!entry) {
+			continue;
+		}
+		int x, y;
+		wlr_scene_node_coords(ancestor, &x, &y);
+		struct wlr_box clip = entry->box;
+		clip.x += x;
+		clip.y += y;
+		if (!wlr_box_contains_point(&clip, lx, ly)) {
+			return false;
+		}
+	}
+	return true;
+}
