+void wlr_scene_tree_set_clip(struct wlr_scene_tree *tree, const struct wlr_box *clip) {
+	assert(tree);
+	assert(!clip || (clip->width >= 0 && clip->height >= 0));
+	struct scene_tree_clip *entry = scene_tree_clip_find(tree);
+	if (!clip && !entry) return;
+	if (clip && entry && memcmp(&entry->box, clip, sizeof(*clip)) == 0) return;
+	wlr_log(WLR_INFO, "SPIKE_CLIP tree=%p rect=%d,%d %dx%d",
+		(void *)tree, clip ? clip->x : 0, clip ? clip->y : 0,
+		clip ? clip->width : 0, clip ? clip->height : 0);
+	if (clip && !entry) {
+		entry = calloc(1, sizeof(*entry));
+		if (!entry) return;
+		entry->tree = tree;
+		entry->destroy.notify = scene_tree_clip_destroy;
+		wl_signal_add(&tree->node.events.destroy, &entry->destroy);
+		entry->next = scene_tree_clips;
+		scene_tree_clips = entry;
+	}
+	if (clip) {
+		entry->box = *clip;
+	} else {
+		scene_tree_clip_remove(entry);
+	}
+	scene_node_update(&tree->node, NULL);
+}
+
+bool wlr_scene_tree_get_clip(struct wlr_scene_tree *tree, struct wlr_box *clip) {
+	assert(tree && clip);
+	struct scene_tree_clip *entry = scene_tree_clip_find(tree);
+	if (!entry) return false;
+	*clip = entry->box;
+	return true;
+}
