 static struct scene_tree_clip *scene_tree_clips;
 
+// WHY: this disposable trace aligns compositor damage and output commits with
+// runner CLOCK_MONOTONIC actions; it does not identify presented frames.
+// CONTRACT: counters are local to this private process and have no ABI/API use.
+// INVARIANT: logging does not change the clip, damage ring or output state.
+static uint64_t temporal_damage_ordinal;
+static uint64_t temporal_commit_ordinal;
+static uint64_t temporal_now_ns(void) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * UINT64_C(1000000000) + (uint64_t)ts.tv_nsec;
+}
