+AMD_G1_MODIFIER = '020000001046bb04'
+UINT32_MAX = (1 << 32) - 1
+
+
+def validate_planes(o):
+    """Bounded metadata sanity, not a proof of allocation extent or DCC layout.
+
+    drm_fourcc.h SHA992f3380...: packed RGB has one image plane;
+    AMD DCC without RETILE adds one auxiliary plane. Only the observed AMD
+    modifier is allowlisted. No DCC size/alignment formula is inferred.
+    """
+    modifier = o['modifier']
+    need(isinstance(modifier, str) and len(modifier) == 16
+         and all(c in '0123456789abcdef' for c in modifier), 'modifier encoding')
+    need(modifier in ('0000000000000000', AMD_G1_MODIFIER), 'unknown modifier')
+    planes = o['planes']
+    need(len(planes) == (2 if modifier == AMD_G1_MODIFIER else 1), 'modifier plane count')
+    for p in planes:
+        need(isinstance(p, list) and len(p) == 2
+             and all(type(n) is int and 0 <= n <= UINT32_MAX for n in p),
+             'pitch/offset uint32 fields')
+        need(p[0] > 0 and p[1] + p[0] <= UINT32_MAX, 'nonzero pitch/offset overflow')
+    pitch, offset = planes[0]
+    need(pitch >= WIDTH * 4 and pitch % 4 == 0, 'packed image stride')
+    image_end = offset + pitch * HEIGHT
+    need(image_end <= UINT32_MAX, 'image extent overflow')
+    if modifier == AMD_G1_MODIFIER:
+        aux_pitch, aux_offset = planes[1]
+        # This fixture only accepts a single-allocation, image-before-aux layout.
+        # Exported FD identity/allocation lengths are absent: this is an explicit
+        # bounded sanity restriction, not a universal DRM modifier requirement.
+        need(aux_offset >= image_end and aux_offset > offset
+             and planes[0] != planes[1], 'auxiliary offset/duplicate sanity')
+        return dict(layout='AMD_GFX11_DCC_NO_RETILE', image_stride='PASS',
+                    auxiliary_fields='PLAUSIBLE_ONLY', auxiliary_extent='NOT_PROVEN',
+                    allocation_bounds='NOT_PROVEN', fd_identity='NOT_OBSERVED')
+    return dict(layout='LINEAR_PACKED', image_stride='PASS',
+                allocation_bounds='NOT_PROVEN')
