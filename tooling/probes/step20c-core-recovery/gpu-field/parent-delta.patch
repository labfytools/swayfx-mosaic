+def validate_g1_envelope(rows, samples, context):
+    """Additional exact G1 native protocol checks, independent of uniform equality.
+
+    A successful envelope never substitutes for validate_epoch/validate_writes.
+    In particular the observed halfpixel mismatch remains a strict rejection.
+    """
+    writes = [r for r in rows if r['kind'] == 'write']
+    copies = [r for r in rows if r['kind'] == 'copy']
+    need(len(writes) == 11 and len(copies) == 2, 'G1 eleven writes/two copies')
+    need([r['sequence'] for r in writes] == list(range(1, 12)), 'G1 ordered writes')
+    need([r['stage'] for r in writes] == list(range(6)) + [-1] * 5, 'G1 stage sequence')
+    for r in writes:
+        need(r['fbo'] == r['read_fbo'] and r['context'] == context
+             and r['viewport'] == [0, 0, WIDTH, HEIGHT], 'G1 draw bindings/context')
+        need(r['texture'] > 0 and r['program'] > 0 and r['color_mask'] == [1]*4
+             and r['stencil'] == r['scissor_enabled'] == 0, 'G1 raster state')
+        need(r['sampler'] in ([9729,9729,33071,33071], [9728,9728,33071,33071]),
+             'G1 effective sampler')
+        uniforms = r['uniforms']
+        names = [u['name'] for u in uniforms]
+        need(len(names) == len(set(names)) and all(n in names for n in ('tex','proj','tex_proj')),
+             'G1 unique sampler/matrix uniforms')
+        u = {u['name']:u for u in uniforms}
+        need(u['tex']['type'] == 35678 and u['tex']['value'] == [0], 'G1 sampler texture unit')
+        need(all(u[n]['type'] == 35675 and len(u[n]['value']) == 9 for n in ('proj','tex_proj')),
+             'G1 matrix type/size')
+        need(all(type(b) is int and 0 <= b <= UINT32_MAX
+                 for x in uniforms for b in x['value']), 'G1 uniform bit encoding')
+        if r['stage'] >= 0:
+            need(u['radius']['type'] == 5126 and u['halfpixel']['type'] == 35664
+                 and len(u['halfpixel']['value']) == 2, 'G1 blur uniform types')
+        else:
+            need(u['alpha']['value'] == [1065353216] and u['discard_transparent']['value'] == [0],
+                 'G1 copy/composition uniforms')
+    for c, seq, src in zip(copies, (7,8), (samples[6]['object'], samples[0]['object'])):
+        validate_object(c['src'], 'main')
+        validate_object(c['dst'], 'main')
+        w = writes[seq-1]
+        need(object_identity(c['src']) == object_identity(src)
+             and w['fbo'] == c['dst']['fbo'] and w['texture'] == c['src']['tex']
+             and w['region'] == c['region'] == [[0,0,WIDTH,HEIGHT]], 'G1 copy continuity')
+        need(rows.index(w) < rows.index(c), 'G1 copy follows raster write')
+    need(rows.index(copies[0]) < rows.index(samples[7]) < rows.index(writes[7])
+         and rows.index(writes[-1]) < rows.index(samples[8]), 'G1 copy/sample order')
+    need(writes[8]['region'] == [[0,0,480,600]]
+         and writes[9]['region'] == writes[10]['region'] == [[480,0,800,600]]
+         and all(w['fbo'] == samples[8]['object']['fbo'] for w in writes[8:]),
+         'G1 final composition regions/target')
+    return dict(writes=11, copies=2, status='STRUCTURAL_ONLY')
