+static void bi_release_hold(const char *reason) {
+    if (!bi_hold.buffer) return;
+    sway_log(SWAY_INFO, "BI_RELEASE id=%" PRIu64 " reason=%s age_ns=%" PRIu64,
+        bi_hold.id, reason, presentation_probe_now_ns() - bi_hold.locked_ns);
+    if (bi_hold.timer) wl_event_source_remove(bi_hold.timer);
+    wlr_buffer_unlock(bi_hold.buffer);
+    memset(&bi_hold, 0, sizeof(bi_hold));
+}
+
+static int bi_timeout_hold(void *data) {
+    bi_release_hold("timeout");
+    return 0;
+}
